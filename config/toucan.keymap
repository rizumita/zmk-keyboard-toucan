#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define SCROLL 5

/ {
    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT &kp LCTRL &kp LALT &kp LGUI>
                     , <&macro_pause_for_release>
                     , <&macro_release &kp LSHFT &kp LCTRL &kp LALT &kp LGUI>;
        };
        
        meh: meh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT &kp LCTRL &kp LALT>
                     , <&macro_pause_for_release>
                     , <&macro_release &kp LSHFT &kp LCTRL &kp LALT>;
        };
    };

    behaviors {
        ret_layer: ret_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };

        space_layer: space_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };
        
        lgui_lang: lgui_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        
        ralt_lang: ralt_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        
        meh_f19: meh_f19 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            hold-while-undecided;
            bindings = <&meh>, <&kp>;
        };
        
        hyper_f16: hyper_f16 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            hold-while-undecided;
            bindings = <&hyper>, <&kp>;
        };

        semi_colon: semi_colon {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        num_sym: num_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        scroll_exit_nav: scroll_exit_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&tog>;
        };

        esc_shift: esc_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            hold-while-undecided;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp SQT &kp COMMA &kp DOT &kp P &kp Y   &kp F &kp G &kp C &kp R &kp L &kp BSPC
                &kp LCTRL &kp A   &kp O     &kp E   &kp U &kp I   &kp D &kp H &kp T &kp N &kp S &kp MINUS
                &kp LSHFT &semi_colon COLON SEMI &kp Q    &kp J   &kp K &kp X   &kp B &kp M &kp W &kp V &kp Z &esc_shift LSHFT ESC
                                &hyper_f16 0 F16 &space_layer 2 SPACE &lgui_lang LGUI LANG2   &ralt_lang RALT LANG1 &ret_layer 1 RET &meh_f19 0 F19
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp ESC     &kp LC(LEFT)    &kp LC(RIGHT) &kp LG(LEFT) &kp LG(RIGHT) &none            &none        &none    &none    &none     &none     &kp BSPC
                &kp LCTRL   &none           &none         &mkp RCLK    &mkp LCLK     &tog SCROLL      &kp HOME     &kp LEFT &kp UP   &kp DOWN  &kp RIGHT &kp END
                &kp LSHFT   &studio_unlock  &trans        &trans       &trans        &trans           &trans       &trans   &trans   &trans    &trans    &trans
                                                &kp LALT          &space_layer 2 SPACE &lgui_lang LGUI LANG2   &ralt_lang RALT LANG1 &ret_layer 1 RET &meh_f19 0 F19
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp BSPC
                &kp LCTRL &num_sym LS(N1) N1 &num_sym LS(N2) N2 &num_sym LS(N3) N3 &num_sym LS(N4) N4 &num_sym LS(N5) N5   &num_sym LS(N6) N6 &num_sym LS(N7) N7 &num_sym LS(N8) N8 &num_sym LS(N9) N9 &num_sym LS(N0) N0 &kp EQUAL
                &kp LSHFT &kp GRAVE &kp LBKT &kp RBKT &kp FSLH &kp BSLH   &kp TILDE &kp LBRC &kp RBRC &kp QMARK &kp PIPE &kp PLUS
                                          &trans &space_layer 2 SPACE &lgui_lang LGUI LANG2   &ralt_lang RALT LANG1 &kp RET &meh_f19 0 F19
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &bt BT_SEL 4 &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans &trans
                &kp LCTRL &trans     &trans       &trans       &trans       &trans         &trans       &kp C_PREV   &kp C_PLAY_PAUSE &kp C_NEXT &trans &trans
                &kp LSHFT &trans     &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans     &trans &trans
                                   &hyper_f16 0 F16 &space_layer 2 SPACE &lgui_lang LGUI LANG2   &ralt_lang RALT LANG1 &kp RET &meh_f19 0 F19
            >;
        };

        mouse {
            status = "reserved";
        };

        scroll {
            display-name = "SCROLL";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                               &trans &trans &trans   &trans &scroll_exit_nav NAV SCROLL &trans
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
